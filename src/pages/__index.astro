---
import {SITE_NAME, BRAND, LEGAL_CITY_WHERE, TIMER, MARQUEE} from '@/const.js';
import Layout from '@/layouts/Layout.astro';
import Banner from '@/blocks/banner/Banner.astro';
import PageTitle from '@/components/PageTitle/Index.astro';
import Timer from '@/blocks/timer/Timer.astro';
import ModelList from '@/blocks/model/ModelList.astro';
import LatestPosts from '@/blocks/latest-posts/LatestPosts.astro';
import Model from '@/blocks/model/Model.astro';
import ModelComplectations from '@/blocks/model/ModelComplectations.astro';
import Callback from '@/blocks/forms/callback/Callback.astro';
import Services from '@/blocks/services/Services.astro';
import Contacts from '@/blocks/contacts/Contacts.astro';
import Morquee from '@/blocks/marquee/Marquee.astro';
import models from '@/data/site/models.json'
import salonsData from '@/data/site/salons.json';
import type { ISalon } from '@/types/ISalon';
const salons = salonsData.filter((salon: ISalon) => !salon?.type || salon?.type.includes('index'));
const modelsWithComplectations = models.filter(m => (m?.complectations !== undefined && m?.complectations.length));
const salonsPhone = salons.map((salon: any) => salon.phone).filter(phone => phone).join(', ');
import SeoText from '@/blocks/seo/Seo.astro';
---

<Layout title=`Купить ${BRAND} у официального дилера ${SITE_NAME}` description=`Забронируйте свой автомобиль прямо сейчас у официалоного дилера ${BRAND} в ${LEGAL_CITY_WHERE}! ☎️ ${salonsPhone}`>
	<Banner />
	{MARQUEE.show && <Morquee marquee={ MARQUEE } />}
	<PageTitle />
	{TIMER.show && <Timer endtime={TIMER.endtime} title={TIMER.title} subtitle={TIMER.subtitle} btnName={TIMER.btnName} />}
	<ModelList />
	<LatestPosts collectionName="special-offers" title="Специальные предложения" id="specials" class="bg-gray-100" />
	<Callback bgUrl="https://cdn.alexsab.ru/b/gac/img/konkurenty.webp" />
	<Services />
	<SeoText mdx="index" />
	<Contacts
		mapImg="https://cdn.alexsab.ru/maps/map-bg.webp"
		title="Наши контакты"
	/>
</Layout>
